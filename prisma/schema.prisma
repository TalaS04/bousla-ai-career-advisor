generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// Runtime Models
// ======================================================

model User {
  id           String      @id @default(cuid())
  fullName     String
  email        String      @unique
  createdAt    DateTime    @default(now())
  passwordHash String
  updatedAt    DateTime    @updatedAt
  interviews   Interview[]
}

model Interview {
  id             String    @id @default(cuid())
  userId         String
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  status         String    @default("IN_PROGRESS")
  analysis       String?   @db.Text
  studentProfile String?   @db.Text
  user           User      @relation(fields: [userId], references: [id])
}

// ======================================================
// Official Knowledge Base
// ======================================================

model DataSource {
  id             String @id @default(cuid())

  name           String @unique
  organization   String
  url            String
  datasetVersion String?
  lastVerified   DateTime

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  classifications Classification[]
  majors          Major[]
  careers         Career[]
  skills          Skill[]
  universities    University[]
}

model Classification {

  id String @id @default(cuid())

  officialCode String @unique

  arabicName String

  englishName String?

  level Int?

  parentId String?

  dataSourceId String

parent Classification? @relation("ClassificationHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

children Classification[] @relation("ClassificationHierarchy")

dataSource DataSource @relation(fields: [dataSourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  majors Major[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([officialCode])

}

model Major {

  id String @id @default(cuid())

  officialCode String @unique

  arabicName String

  englishName String?

  description String? @db.Text

  classificationId String

  dataSourceId String

  classification Classification @relation(fields: [classificationId], references: [id])

  dataSource DataSource @relation(fields: [dataSourceId], references: [id])

  majorSkills MajorSkill[]

  majorCareers MajorCareer[]

  collegeMajors CollegeMajor[]

  riasecProfile MajorRiasecProfile?

  roadmap MajorRoadmap?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([officialCode])

  includedSpecializations String? @db.Text

  coreSubjects String? @db.Text

}

model Career {

  id String @id @default(cuid())

  officialCode String @unique

  arabicName String

  englishName String?

  description String? @db.Text

  occupationGroup String?

  dataSourceId String

  dataSource DataSource @relation(fields: [dataSourceId], references: [id])

  majorCareers MajorCareer[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([officialCode])

}

model Skill {

  id String @id @default(cuid())

  officialCode String @unique

  arabicName String

  englishName String?

  category String?

  description String? @db.Text

  dataSourceId String

  dataSource DataSource @relation(fields: [dataSourceId], references: [id])

  majorSkills MajorSkill[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([officialCode])

}

model University {

  id String @id @default(cuid())

  arabicName String @unique

  englishName String?

  city String?

  website String?

  sector String?

  // New official Study in Saudi fields
  ministryId Int?
  businessCode String?
  logoUrl String?
  imageUrl String?

  dataSourceId String

  dataSource DataSource @relation(fields: [dataSourceId], references: [id])

  colleges College[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}

model College {

  id String @id @default(cuid())

  officialCode String?

  arabicName String

  englishName String?

  universityId String

  university University @relation(fields: [universityId], references: [id])

  collegeMajors CollegeMajor[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([universityId, arabicName])

}

// ======================================================
// Relationship Tables
// ======================================================

model MajorSkill {

  majorId String

  skillId String

  importance Int?

  major Major @relation(fields: [majorId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  skill Skill @relation(fields: [skillId], references: [id])

  @@id([majorId, skillId])

}

model MajorCareer {

  majorId String

  careerId String

  matchLevel Int?

  major Major @relation(fields: [majorId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  career Career @relation(fields: [careerId], references: [id])

  @@id([majorId, careerId])

}

model CollegeMajor {

  collegeId String

  majorId String

  college College @relation(fields: [collegeId], references: [id])

  major Major @relation(fields: [majorId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@id([collegeId, majorId])

}

// ======================================================
// BOUSLA Intelligence
// ======================================================

model MajorRiasecProfile {

  majorId String @id

  realistic Int

  investigative Int

  artistic Int

  social Int

  enterprising Int

  conventional Int

  major Major @relation(fields: [majorId], references: [id])

}

model MajorRoadmap {

  majorId String @id

  overview String? @db.Text

  learningPath String? @db.Text

  certifications String? @db.Text

  activities String? @db.Text

  tools String? @db.Text

  major Major @relation(fields: [majorId], references: [id])

}